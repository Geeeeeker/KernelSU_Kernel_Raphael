# Example: Raphael (Linux 4.14) Non-GKI kernel with ReSukiSU.
#
# Run it with:  Actions -> Build Kernel -> Config file to build =
#               config/raphael-4.14-resukisu.env
#
# ReSukiSU is a re-fork of SukiSU-Ultra focused on legacy and non-GKI kernels,
# with multi-manager support. This profile matches the verified working
# configuration for the Raphael 4.14 HyperMIUI-erofs tree.

CONFIG_ENV=config/raphael-4.14-resukisu.env

# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/SOVIET-ANDROID/kernel_xiaomi_raphael
KERNEL_SOURCE_BRANCH=14.0
KERNEL_CONFIG=raphael_defconfig
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64

# Optional: overrides the device label used in artifact names and sets
# CONFIG_LOCALVERSION. Leave blank to derive it from KERNEL_CONFIG.
KERNEL_NAME=

# Extra flags appended to every make invocation. Values may contain "=".
EXTRA_CMDS:LD=ld.lld
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
#
# Newer clang does not build 4.x trees reliably.
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

USE_CUSTOM_CLANG=true
CUSTOM_CLANG_SOURCE=https://github.com/Neutron-Toolchains/clang-build-catalogue/releases/download/10032024/neutron-clang-10032024.tar.zst
CUSTOM_CLANG_BRANCH=

# Build fully with LLVM (LLVM=1 LLVM_IAS=1). Good for 5.10+, usually breaks 4.x.
USE_LLVM=false

# ===================================================================== GCC ==
#
# Only needed as binutils for older trees that cannot use LLVM's integrated
# assembler. Leave both off when USE_LLVM=true.
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===
#
# ReSukiSU is a re-fork of SukiSU-Ultra focused on legacy and non-GKI kernels.
# KSU_REF is a branch, tag or commit. v4.2.0-rc3 is the verified working tag
# for this kernel tree.
KSU_VARIANT=resukisu
KSU_REF=v4.2.0-rc3

# auto | kprobes | manual | tracepoint | syscall | none
# kprobes is unreliable on 4.x; this tree uses external hook patches instead
# (execve-hook, faccessat-hook, stat-hook, sys_reboot-hook), so the action's
# own hook mode is disabled.
KSU_HOOK_MODE=none

# Custom manager APK signature. Leave blank for the official manager.
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
#
# Disabled in the verified working configuration. The external susfs4ksu
# kernel-4.14 patch does not apply cleanly against ReSukiSU's restructured
# source tree, so SUSFS is left off to keep the root solution functional.
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===

# path_umount() arrived in Linux 5.9. KernelSU uses it to unmount its own
# overlays before a root check runs, so older kernels need it backported.
ENABLE_PATH_UMOUNT=false

# Extra fingerprint removal on top of SUSFS. Requires ENABLE_SUSFS=true.
ENABLE_HIDE_STUFF=false

# SukiSU-Ultra's Kernel Patch Module support. arm64 only.
# Only supported with KSU_VARIANT=sukisu-ultra; keep false for resukisu.
ENABLE_KPM=false

# ================================================================ Kconfig ===

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=false

# Free-form defconfig lines, space or newline separated.
EXTRA_DEFCONFIG=

# ============================================================= AnyKernel3 ===

USE_CUSTOM_ANYKERNEL3=true
CUSTOM_ANYKERNEL3_SOURCE=https://github.com/onettboots/boolx_anykernel
CUSTOM_ANYKERNEL3_BRANCH=Miui

# ============================================================== Packaging ===

NEED_DTBO=false

# Repack a boot.img around the new kernel.
BUILD_BOOT_IMG=true
SOURCE_BOOT_IMAGE=https://github.com/5kind/payload-dumper/releases/download/boot-images/Raphael_MIUI14_3.8_by_KameYuki-boot.img

# ================================================================= Runner ===

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
